{
  "settings": {
    "chunk_size": 500,
    "overlap": 50,
    "k": 3,
    "embedding_model": "default"
  },
  "corpora": {
    "sample": {
      "docs_dir": "data/sample_docs",
      "eval_file": "data/eval_set.json"
    },
    "current_events": {
