# Copy to .env (gitignored) for local development and fill in the password. Nothing here is a real secret.
# POSTGRES_PASSWORD is the local container's password; generate one, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me
# 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and connections can hang for a long time.
# Port 5433 because a PostgreSQL installed on this PC already uses 5432.
DATABASE_URL=postgresql://gateway:change-me@127.0.0.1:5433/gateway
